# Undrepost app environment (spec 001-init-from-payload / quickstart.md)
PAYLOAD_SECRET=CHANGE_ME_32_BYTES_MIN
DATABASE_URI=postgres://postgres:postgres@127.0.0.1:5432/undrepost

# Auth seam (review F4 / FR-013): 'directus' = undrlla IdP session bridge (ecosystem),
# 'payload-local' = Payload native auth on Members (standalone $149 SKU + local dev)
AUTH_STRATEGY=payload-local

# IdP contract (members.contract.md) — only used when AUTH_STRATEGY=directus
IDP_ISSUER=https://id.undrlla.network
IDP_JWKS_URL=https://id.undrlla.network/.well-known/jwks.json
IDP_TENANT_ID=undrepost

# Admin bootstrap by sub ONLY (never email) — comma-separated IdP sub values
ADMIN_ALLOWLIST=

SITE_URL=http://localhost:3000
