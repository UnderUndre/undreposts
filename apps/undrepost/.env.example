# Undrepost app environment (spec 001-init-from-payload / quickstart.md)
PAYLOAD_SECRET=CHANGE_ME_32_BYTES_MIN
DATABASE_URI=postgres://postgres:postgres@127.0.0.1:5432/undrepost

# Auth seam (review F4 / FR-013): 'directus' = undrlla IdP session bridge (ecosystem),
# 'payload-local' = Payload native auth on Members (standalone $149 SKU + local dev)
AUTH_STRATEGY=payload-local

# IdP contract (members.contract.md) — only used when AUTH_STRATEGY=directus
IDP_ISSUER=https://id.undrlla.network
IDP_JWKS_URL=https://id.undrlla.network/.well-known/jwks.json
IDP_TENANT_ID=undrepost

# Admin bootstrap by sub ONLY (never email) — comma-separated IdP sub values
ADMIN_ALLOWLIST=

SITE_URL=http://localhost:3000

# --- P2 integrations (spec 001 Wave-1) ---

# T2.8: S3 storage (unset S3_BUCKET → local disk upload; MinIO fixture:
# docker compose -f docker-compose.minio.yml up -d)
S3_BUCKET=
S3_ENDPOINT=
S3_REGION=us-east-1
S3_ACCESS_KEY_ID=
S3_SECRET_ACCESS_KEY=

# T2.3/T2.5/T2.2: SSE + interactions (all authenticated endpoints)
# SSE per-user connection cap is fixed at 5.

# T2.1b: comment gating — 'default' | 'disabled'; rate limit 10/h per member
COMMENT_POLICY=default
COMMENT_RATE_LIMIT=10

# T2.6: newsletter double opt-in — unset RESEND_API_KEY = dev dry-run transport
RESEND_API_KEY=
NEWSLETTER_FROM=

# T2.17: syndication (unset TELEGRAM_* → SyndicationLog 'telegram-not-configured',
# publish NEVER fails — FM-02). Set SYNDICATION_DISABLED=true to skip entirely.
TELEGRAM_BOT_TOKEN=
TELEGRAM_CHAT_ID=
SYNDICATION_DISABLED=

# T2.20: tombstone sweep — unset = job skips with a log line; when set the
# sweep runs FAIL-CLOSED (aborts on any IdP error or >5% tombstone share)
IDP_M2M_TOKEN=
IDP_ACTIVE_USERS_URL=
